includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    ignoreErrors:
        -
            identifier: trait.unused
            path: src/Models/Concerns/OwnedByUser.php
    level: 5
    paths:
        - src
    universalObjectCratesClasses:
        - Amarenkov\MutableContent\Contracts\MutableModel
