{
    "name": "amarenkov/laravel-mutable-content",
    "description": "Laravel models with user-defined fields: typed JSON fields added without migrations, lists of values, and a trigger-based change log on PostgreSQL and MariaDB.",
    "type": "library",
    "keywords": [
        "laravel",
        "eloquent",
        "jsonb",
        "postgresql",
        "mariadb",
        "dynamic-fields",
        "custom-fields",
        "lov",
        "audit-log",
        "change-log",
        "database-triggers"
    ],
    "homepage": "https://github.com/amarenkov/laravel-mutable-content",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexey Marenkov",
            "email": "alex@marenkov.dev",
            "homepage": "https://github.com/amarenkov"
        }
    ],
    "support": {
        "issues": "https://github.com/amarenkov/laravel-mutable-content/issues",
        "source": "https://github.com/amarenkov/laravel-mutable-content"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.8"
    },
    "autoload": {
        "psr-4": {
            "Amarenkov\\MutableContent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amarenkov\\MutableContent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Amarenkov\\MutableContent\\MutableContentServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "suggest": {
        "filament/filament": "For admin UI management",
        "dedoc/scramble": "For API documentation integration"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "larastan/larastan": "^3.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
